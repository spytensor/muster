# Copy to deploy/.env and fill in. Nothing here is a real secret.

# The address people will open, with https. No trailing slash.
MUSTER_PUBLIC_URL=https://muster.example.com
# The first person allowed in; they become the owner and invite everyone else.
MUSTER_BOOTSTRAP_OWNER_EMAIL=you@example.com
MUSTER_ORG_NAME=Example Inc
POSTGRES_PASSWORD=change-me
# Set to 1 when a reverse proxy in front adds X-Forwarded-For.
MUSTER_TRUST_PROXY=1

# The most tokens one person's agents may use in a day (UTC). Leave empty for no limit.
MUSTER_DAILY_TOKENS_PER_USER=

# The largest file a person may upload, in megabytes.
MUSTER_MAX_FILE_MB=25

# Sign-in. At least one provider is required.
# Google: redirect URI is <MUSTER_PUBLIC_URL>/auth/callback/google
MUSTER_GOOGLE_CLIENT_ID=
MUSTER_GOOGLE_CLIENT_SECRET=
# Microsoft: redirect URI is <MUSTER_PUBLIC_URL>/auth/callback/microsoft
MUSTER_MICROSOFT_CLIENT_ID=
MUSTER_MICROSOFT_CLIENT_SECRET=
MUSTER_MICROSOFT_TENANT=
# Who gets in: everyone in this directory becomes a member the first time they sign in;
# nobody is invited. For that the registration must send two optional claims in the ID
# token (Entra: App registrations > Token configuration > Add optional claim > ID):
#   xms_edov  the address's domain is verified by the directory
#   acct      whether the account is a member (0) or a guest (1) of the directory
# Without acct nobody is admitted by the directory: Muster does not guess that an
# account is not a guest.
# To let people connect their Microsoft 365 (mail, calendar, files, Teams chats, read only),
# the same registration also needs the redirect URI
# <MUSTER_PUBLIC_URL>/api/app/connectors/microsoft/callback, the delegated Graph permissions
# offline_access User.Read Mail.Read Calendars.Read Files.Read.All Sites.Read.All Chat.Read,
# and a key below. The key seals the tokens kept for each person: 32 characters or more,
# for example from `openssl rand -base64 48`. Keep it with the backups: without it the
# stored connections cannot be opened and people connect again. Empty: no connections offered.
MUSTER_SECRET_KEY=

# Web search for agents. Off unless you turn it on: what an agent searches for (up to 200
# characters, which could be something it has read) leaves the company for the search
# service. With it off, agents read only the addresses people give them.
# One of three, never several. The dependable choice is a paid service:
# MUSTER_SEARCH1API_KEY=   # https://www.search1api.com, one credit a search
# Or run a SearXNG here, in this compose file (free; public engines throttle a server
# that asks often). Set all three:
# COMPOSE_PROFILES=search
# MUSTER_SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=        # its own, e.g. from `openssl rand -hex 32`

# Running code. The sandbox service starts with the rest and agents use it; nothing has
# to be set. It needs gVisor in Docker (a runtime whose name holds "runsc") and runs
# nothing without one. See docs/features/sandbox.md.
# MUSTER_SANDBOX_URL=          # set to nothing to give agents no way to run code
# SANDBOX_RUNTIME=runsc        # use this Docker runtime, not the one found
# SANDBOX_DOCKER_SOCK=/run/user/1000/docker.sock   # found by scripts/deploy-commit.sh; set it when starting compose by hand under a rootless Docker
# SANDBOX_ALLOW_CONTAINER=1    # run in an ordinary container; not for production
# How much code one person's agents may run in a day (UTC): runs, and processor seconds.
# 200 and 3600 when left out; 0 takes that limit away. Which hosts code may reach is
# set in the admin console (Models), not here.
# MUSTER_SANDBOX_DAILY_RUNS=200
# MUSTER_SANDBOX_DAILY_CPU_SECONDS=3600
# Or Tavily:
# MUSTER_TAVILY_API_KEY=
# The company's own single sign-on, if it speaks OpenID Connect (Keycloak, Authing, Okta,
# Authentik, ...): redirect URI is <MUSTER_PUBLIC_URL>/auth/callback/oidc
# The issuer is the address whose /.well-known/openid-configuration describes the provider.
MUSTER_OIDC_ISSUER=
MUSTER_OIDC_CLIENT_ID=
MUSTER_OIDC_CLIENT_SECRET=
# What the sign-in button says, e.g. "Northwind SSO".
MUSTER_OIDC_LABEL=
# Set to 1 only if every account in that provider was given its address by the company
# (nobody can register themselves). Without it, an account from this provider can accept
# an invitation but cannot be the first owner, join by a domain rule, or be matched to a
# person who already signs in another way. With it, addresses are also believed when the
# provider does not say it verified them.
MUSTER_OIDC_TRUST_EMAIL=
# Set to 1, with MUSTER_OIDC_TRUST_EMAIL=1, only when every account in this provider is
# one the company gave out: its people then become members by signing in. Leave unset for
# a provider people can register at themselves.
# MUSTER_OIDC_DIRECTORY=

# How many days a sign-in lasts before the person signs in again.
MUSTER_SESSION_DAYS=7

# The model agents run on. "anthropic" or "openai" (any endpoint that speaks OpenAI chat completions).
# Optional: an administrator can set the model, its key and its prices in Admin console → Models
# instead (that needs MUSTER_SECRET_KEY). What is chosen there replaces what is set here.
MUSTER_MODEL_API=
MUSTER_MODEL_ID=
MUSTER_MODEL_BASE_URL=
MUSTER_MODEL_API_KEY=
# Set to 1 when the model can be shown images.
MUSTER_MODEL_VISION=
# US dollars per million tokens, used for the cost shown on each run.
MUSTER_MODEL_INPUT_PRICE=
MUSTER_MODEL_OUTPUT_PRICE=
# What the service charges for prompt tokens it read from its cache, and for those it
# wrote there. Leave empty to count them at the input price.
MUSTER_MODEL_CACHED_INPUT_PRICE=
MUSTER_MODEL_CACHE_WRITE_PRICE=
# Seconds the model may take before its first word (default 180), and seconds it may then
# say nothing (default 90), before the call is given up. A call with no word is tried twice.
# Lower both for a fast hosted model; keep them for a slow one you host yourself.
MUSTER_MODEL_FIRST_WORD_SECONDS=
MUSTER_MODEL_SILENCE_SECONDS=
# The most the model may write in one go, in tokens (default 16000). A workbook or a deck
# an agent makes is written in one go; set it as high as your model allows.
MUSTER_MODEL_MAX_OUTPUT_TOKENS=
# For a model that thinks before it answers: how hard, on every call (none, minimal, low,
# medium, high, xhigh, max; which of these a service knows is the service's). Its thinking
# counts against the limit above. Left empty, the model's own default applies; a call that
# thinks its allowance away and says nothing is asked again once, told not to think.
MUSTER_MODEL_REASONING_EFFORT=
# A second model, asked when the first cannot be reached or fails before saying anything.
# Only its name is required: the service, protocol and key are the first model's unless given.
MUSTER_MODEL_FALLBACK_ID=
MUSTER_MODEL_FALLBACK_API=
MUSTER_MODEL_FALLBACK_BASE_URL=
MUSTER_MODEL_FALLBACK_API_KEY=
MUSTER_MODEL_FALLBACK_INPUT_PRICE=
MUSTER_MODEL_FALLBACK_OUTPUT_PRICE=
MUSTER_MODEL_FALLBACK_VISION=
