{
  "name": "@muster/desktop",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "Muster for the desktop: the workspace in its own window, signed in through the system browser.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "package": "pnpm build && node scripts/package.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^22.0.0",
    "electron": "45.3.2"
  }
}
