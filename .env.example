# Settings for running Muster on your own machine with `pnpm dev`.
# Copy to .env (never committed) and fill in. For a deployment, see deploy/.env.example.

# The model agents run on: "anthropic", or "openai" for any endpoint that speaks OpenAI
# chat completions.
MUSTER_MODEL_API=openai
MUSTER_MODEL_ID=
MUSTER_MODEL_BASE_URL=
MUSTER_MODEL_API_KEY=
# Set to 1 when the model can be shown images (for example a vision model).
MUSTER_MODEL_VISION=
# US dollars per million tokens, for the cost shown on each run.
MUSTER_MODEL_INPUT_PRICE=
MUSTER_MODEL_OUTPUT_PRICE=
# Seconds the model may take before its first word (default 180), and seconds it may then
# say nothing (default 90), before the call is given up. A call with no word is tried twice.
# Lower both for a fast hosted model; keep them for a slow one you host yourself.
MUSTER_MODEL_FIRST_WORD_SECONDS=
MUSTER_MODEL_SILENCE_SECONDS=
# How much the model can be shown at once, in tokens (default 128000). Set it to the
# model's real window: a conversation longer than this is trimmed and then summarised to
# fit (docs/features/coding.md).
MUSTER_MODEL_CONTEXT_WINDOW=
# The most the model may write in one go, in tokens (default 16000). A workbook or a deck
# an agent makes is written in one go; set it as high as your model allows.
MUSTER_MODEL_MAX_OUTPUT_TOKENS=
# For a model that thinks before it answers: how hard, on every call (none, minimal, low,
# medium, high, xhigh, max; which of these a service knows is the service's). Its thinking
# counts against the limit above. Left empty, the model's own default applies; a call that
# thinks its allowance away and says nothing is asked again once, told not to think.
MUSTER_MODEL_REASONING_EFFORT=
# A second model, asked when the first cannot be reached or fails before saying anything.
# Only its name is required: the service, protocol and key are the first model's unless given.
MUSTER_MODEL_FALLBACK_ID=
MUSTER_MODEL_FALLBACK_API=
MUSTER_MODEL_FALLBACK_BASE_URL=
MUSTER_MODEL_FALLBACK_API_KEY=
MUSTER_MODEL_FALLBACK_INPUT_PRICE=
MUSTER_MODEL_FALLBACK_OUTPUT_PRICE=
MUSTER_MODEL_FALLBACK_VISION=

# Keep development data between restarts (people stay signed in, files and conversations stay).
# Use full paths. Delete the folder to start again from the sample organization.
# MUSTER_DATA_DIR=/full/path/to/Muster/.dev-data/db
# MUSTER_FILES_DIR=/full/path/to/Muster/.dev-data/files

# A value may point at a variable your shell already has, e.g. MUSTER_MODEL_API_KEY=${MY_PROVIDER_KEY}
